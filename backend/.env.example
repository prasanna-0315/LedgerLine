# Copy to .env (never commit .env). All values below are placeholders.
PORT=5000
NODE_ENV=development
# Runtime role (ledgerline_app) - NOT the owner/migration role
DATABASE_URL=postgresql://ledgerline_app:CHANGE_ME@localhost:5432/ledgerline
# Owner/migration role, used only by `prisma migrate deploy` and roles.sql
MIGRATION_DATABASE_URL=postgresql://owner:CHANGE_ME@localhost:5432/ledgerline
JWT_SECRET=generate-with-openssl-rand-hex-48
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:5173
